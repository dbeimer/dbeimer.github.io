---
import { MDXLayoutProps } from "astro";
import MainLayout from "../layouts/MainLayout.astro";
type Props = MDXLayoutProps<{
  title: string;
  author: string;
  date: string;
  heroImage: string;
}>;

const { frontmatter } = Astro.props;
---

<MainLayout>
  <section class="mt-20 max-w-3xl mx-auto px-2">
    {frontmatter.heroImage && (
      <div
        class="scanlines h-72 md:h-80 bg-cover bg-center grayscale mb-8 hero-image-reveal"
        style={`background-image:url('${frontmatter.heroImage}')`}
        aria-label="Imagen principal del artículo"
      />
    )}
    <div class="mb-10 hero-text-reveal">
      <h1 class="mt-2 font-mono text-xl sm:text-2xl md:text-3xl font-semibold tracking-tight">{frontmatter.title}</h1>
      <p class="mt-3 font-mono text-[10px] text-black/30 dark:text-white/30 flex gap-3 tracking-wider">
        <span>{frontmatter.author}</span>
        <span aria-hidden="true">/</span>
        <span>{frontmatter.date}</span>
      </p>
    </div>
    <article class="blog-content hero-text-reveal-delay">
      <slot />
    </article>
  </section>
</MainLayout>
<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  @layer base {
    .blog-content h1 {
      @apply text-2xl mb-3 mt-8 font-semibold font-mono tracking-tight;
    }
    .blog-content h2 {
      @apply text-xl mt-10 mb-4 font-semibold font-mono tracking-tight;
      position: relative;
      padding-bottom: 8px;
    }
    .blog-content h2::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 40px;
      height: 1px;
      background: currentColor;
      opacity: 0.2;
    }
    .blog-content h3 {
      @apply text-lg mt-8 mb-3 font-semibold font-mono tracking-tight;
    }
    .blog-content pre {
      margin: 28px 0 !important;
      border-radius: 0 !important;
      border: 1px solid rgba(0, 0, 0, 0.08) !important;
      border-left: 2px solid rgba(0, 0, 0, 0.2) !important;
      overflow: hidden !important;
      background: #f5f5f5 !important;
      position: relative;
    }
    .dark .blog-content pre {
      background: #161616 !important;
      border-color: rgba(255, 255, 255, 0.1) !important;
      border-left: 2px solid rgba(255, 255, 255, 0.25) !important;
    }
    .blog-content pre > code {
      display: block !important;
      padding: 20px 20px 20px 18px !important;
      overflow-x: auto !important;
      scrollbar-width: thin !important;
      font-size: 12px !important;
      line-height: 1.7 !important;
      font-family: 'JetBrains Mono', ui-monospace, "SF Mono", Monaco, "Cascadia Code", Menlo, monospace !important;
      background: transparent !important;
      border-radius: 0 !important;
      position: relative;
      z-index: 1;
    }
    .blog-content p {
      @apply text-black/55 dark:text-white/55 text-sm leading-[1.8] mb-4;
    }
    .blog-content a {
      @apply text-black dark:text-white no-underline transition-opacity font-mono text-xs;
      border-bottom: 1px solid currentColor;
      padding-bottom: 1px;
    }
    .blog-content a:hover {
      opacity: 0.5;
    }
    .blog-content ul, .blog-content ol {
      @apply list-disc ml-6 mb-3 text-sm text-black/50 dark:text-white/50;
    }
    .blog-content li {
      @apply mb-1 leading-[1.7];
    }
    .blog-content :not(pre) > code {
      background: rgba(0, 0, 0, 0.06) !important;
      color: inherit !important;
      padding: 2px 8px !important;
      border-radius: 0 !important;
      font-size: 0.8em !important;
      font-family: 'JetBrains Mono', ui-monospace, "SF Mono", Monaco, "Cascadia Code", Menlo, monospace !important;
    }
    .dark .blog-content :not(pre) > code {
      background: rgba(255, 255, 255, 0.08) !important;
    }
    .blog-content blockquote {
      border-left: 2px solid currentColor;
      padding-left: 16px;
      margin: 16px 0;
      opacity: 0.5;
      font-style: italic;
    }
  }
</style>
